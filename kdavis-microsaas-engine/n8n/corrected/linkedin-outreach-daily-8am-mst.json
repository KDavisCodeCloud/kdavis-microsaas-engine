{
  "name": "LinkedIn Outreach \u2014 Daily 8am MST",
  "active": true,
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "8am MST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *",
              "__originalUtcExpression": "0 15 * * *"
            }
          ]
        }
      }
    },
    {
