{
  "name": "Re-engagement Trigger \u2014 Daily 09:00 MST",
  "active": true,
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Daily 09:00 MST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *",
              "__originalUtcExpression": "0 16 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "get-active-tenants",
      "name": "Get Active Tenants",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        420,
        300
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "tenants",
        "filterType": "string",
        "filterString": "status=eq.active"
      },
      "credentials": {
        "supabaseApi": {
          "id": "pUAkmUAHr9FYYZCw",
          "name": "microsaas-prod Supabase"
        }
      },
      "notes": "BLOCKED: credential 'microsaas-prod Supabase' cannot be decrypted (encrypted under a previous N8N_ENCRYPTION_KEY). Re-enter the Supabase service key on this credential in the n8n UI, then this node works again.",
      "notesInFlow": true
    },
    {
      "id": "evaluate-each",
      "name": "For Each Tenant",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        640,
        300
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "call-reengagement-api",
      "name": "Evaluate Reengagement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/reengagement/evaluate/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.MARKETING_API_KEY }}"
            }
          ]
        }
      }
    },
    {
      "id": "has-triggers",
      "name": "Any Triggered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-triggered",
              "leftValue": "={{ $json.triggered.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "send-reengagement-email",
      "name": "Send Re-engagement Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.RESEND_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'team@' + $env.PRODUCT_DOMAIN, to: $('Get Active Tenants').item.json.email, subject: \"We noticed you haven't logged in recently\", text: 'Hey \u2014 your account is still active. Log in to see where things stand: ' + $env.APP_URL }) }}"
      }
    }
  ],
  "connections": {
    "Daily 09:00 MST": {
      "main": [
        [
          {
            "node": "Get Active Tenants",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Active Tenants": {
      "main": [
        [
          {
            "node": "For Each Tenant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "For Each Tenant": {
      "main": [
        [
          {
            "node": "Evaluate Reengagement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Reengagement": {
      "main": [
        [
          {
            "node": "Any Triggered?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Triggered?": {
      "main": [
        [
          {
            "node": "Send Re-engagement Email",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}