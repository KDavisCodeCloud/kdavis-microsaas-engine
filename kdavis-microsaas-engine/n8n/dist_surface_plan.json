{
    "id": "dist-surface-plan-001",
    "name": "DIST Surface Plan — Monthly",
    "active": false,
    "settings": {
        "executionOrder": "v1"
    },
    "staticData": null,
    "pinData": {},
    "nodes": [
        {
            "id": "cron-trigger",
            "name": "1st of Month",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 6 1 * *"
                        }
                    ]
                }
            },
            "position": [
                200,
                300
            ]
        },
        {
            "id": "run-surface-plan",
            "name": "Trigger DIST-S1 Run",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "parameters": {
                "method": "POST",
                "url": "={{ $env.API_BASE_URL }}/dist/surfaces/plan",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "={{ 'Bearer ' + $env.MARKETING_API_KEY }}"
                        }
                    ]
                }
            },
            "position": [
                420,
                300
            ]
        }
    ],
    "connections": {
        "1st of Month": {
            "main": [
                [
                    {
                        "node": "Trigger DIST-S1 Run",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}
