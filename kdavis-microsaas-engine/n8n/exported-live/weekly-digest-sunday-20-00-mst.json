{
  "name": "Weekly Digest \u2014 Sunday 20:00 MST",
  "active": true,
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Sunday 20:00 MST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 20 * * 0"
            }
          ]
        }
      }
    },
    {
      "id": "get-active-tenants",
      "name": "Get Active Tenants",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        420,
        300
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "tenants",
        "filterType": "string",
        "filterString": "status=eq.active"
      },
      "credentials": {
        "supabaseApi": {
          "id": "pUAkmUAHr9FYYZCw",
          "name": "microsaas-prod Supabase"
        }
      }
    },
    {
      "id": "process-each-tenant",
      "name": "For Each Tenant",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        640,
        300
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "preview-digest",
      "name": "Preview Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/digest/preview/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.MARKETING_API_KEY }}"
            }
          ]
        }
      }
    },
    {
      "id": "check-has-content",
      "name": "Has Content?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-not-422",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 422,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "send-email",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.RESEND_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'digest@' + $env.PRODUCT_DOMAIN, to: $('Get Active Tenants').item.json.email, subject: $('Preview Digest').item.json.subject, text: $('Preview Digest').item.json.body }) }}"
      }
    },
    {
      "id": "log-sent",
      "name": "Log Sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1520,
        200
      ],
      "parameters": {
        "operation": "create",
        "tableId": "weekly_digest_log",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "tenant_id",
              "fieldValue": "={{ $('Get Active Tenants').item.json.id }}"
            },
            {
              "fieldId": "value_metrics",
              "fieldValue": "={{ JSON.stringify($('Preview Digest').item.json.value_metrics) }}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "pUAkmUAHr9FYYZCw",
          "name": "microsaas-prod Supabase"
        }
      }
    },
    {
      "id": "log-skipped",
      "name": "Log Skipped",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1300,
        400
      ],
      "parameters": {
        "operation": "create",
        "tableId": "weekly_digest_log",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "tenant_id",
              "fieldValue": "={{ $('Get Active Tenants').item.json.id }}"
            },
            {
              "fieldId": "skipped_reason",
              "fieldValue": "no_usage"
            },
            {
              "fieldId": "value_metrics",
              "fieldValue": "{}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "pUAkmUAHr9FYYZCw",
          "name": "microsaas-prod Supabase"
        }
      }
    }
  ],
  "connections": {
    "Sunday 20:00 MST": {
      "main": [
        [
          {
            "node": "Get Active Tenants",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Active Tenants": {
      "main": [
        [
          {
            "node": "For Each Tenant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "For Each Tenant": {
      "main": [
        [
          {
            "node": "Preview Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preview Digest": {
      "main": [
        [
          {
            "node": "Has Content?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Content?": {
      "main": [
        [
          {
            "node": "Send via Resend",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Skipped",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send via Resend": {
      "main": [
        [
          {
            "node": "Log Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}