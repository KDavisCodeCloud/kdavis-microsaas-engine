{
  "name": "Weekly Digest \u2014 Sunday 20:00 MST",
  "active": true,
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Sunday 20:00 MST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 20 * * 0"
            }
          ]
        }
      }
    },
    {
      "id": "get-active-tenants",
      "name": "Get Active Tenants",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        420,
        300
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "tenants",
        "filterType": "string",
        "filterString": "status=eq.active"
      },
      "credentials": {
        "supabaseApi": {
          "id": "pUAkmUAHr9FYYZCw",
          "name": "microsaas-prod Supabase"
        }
      }
    },
    {
      "id": "process-each-tenant",
      "name": "For Each Tenant",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        640,
        300
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "preview-digest",
      "name": "Preview Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/digest/preview/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.MARKETING_API_KEY }}"
            }
          ]
        }
      }
    },
    {
      "id": "check-has-content",
      "name": "Has Content?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-not-422",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 422,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "send-email",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.RESEND_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'digest@' + $env.PRODUCT_DOMAIN, to: $('Get Active Tenants').item.json.email, subject: $('Preview Digest').item.json.subject, text: $('Preview Digest').item.json.body }) }}"
      }
    },
    {
      "id": "log-sent",
      "name": "Log Sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1520,
        200
      ],
      "parameters": {
        "operation": "create",
        "tableId": "weekly_digest_log",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "tenant_id",
              "fieldValue": "={{ $('Get Active Tenants').item.json.id }}"
            },
            {
              "fieldId": "value_metrics",
              "fieldValue": "={{ JSON.stringify($('Preview Digest').item.json.value_metrics) }}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "pUAkmUAHr9FYYZCw",
          "name": "microsaas-prod Supabase"
        }
      }
    },
    {
      "id": "log-skipped",
      "name": "Log Skipped",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1300,
        400
      ],
      "parameters": {
        "operation": "create",
        "tableId": "weekly_digest_log",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "tenant_id",
              "fieldValue": "={{ $('Get Active Tenants').item.json.id }}"
            },
            {
              "fieldId": "skipped_reason",
              "fieldValue": "no_usage"
            },
            {
              "fieldId": "value_metrics",
              "fieldValue": "{}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "pUAkmUAHr9FYYZCw",
          "name": "microsaas-prod Supabase"
        }
      }
    },
    {
      "id": "wd-leadsummary",
      "name": "Get Weekly Lead Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        620
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/marketing/leads/weekly-summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.MARKETING_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wd-leadreport",
      "name": "Build Lead Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Weekly lead-finder report. Reads /marketing/leads/weekly-summary, which\n// reports what COMPLETED -- the 06:00 workflow only queues.\nconst d = $input.first().json || {};\nconst f = d.funnel || {};\nconst b = d.brave_budget || {};\nconst runs = Array.isArray(d.runs) ? d.runs : [];\n\nconst lines = [];\nlines.push('FUNNEL (last ' + (d.window_days || 7) + ' days)');\nlines.push('  qualified : ' + (f.qualified != null ? f.qualified : 'n/a'));\nlines.push('  approved  : ' + (f.approved != null ? f.approved : 'n/a'));\nlines.push('  sent      : ' + (f.sent != null ? f.sent : 'n/a'));\n// null means NOT MEASURED. Printing 0 here would claim nobody replied.\nlines.push('  replies   : ' + (f.replies == null ? 'not measured' : f.replies));\nlines.push('  calls     : ' + (f.calls_booked == null ? 'not measured' : f.calls_booked));\n\nlines.push('');\nlines.push('RUNS');\nif (!runs.length) {\n  lines.push('  none in the window');\n} else {\n  for (const r of runs) {\n    let line = '  ' + String(r.started_at || '').slice(0, 16) + '  ' +\n               (r.product || r.product_id || '?') + '  ' + r.status;\n    if (r.status === 'running' && r.current_step) line += ' (at: ' + r.current_step + ')';\n    if (r.leads_found != null) line += '  found=' + r.leads_found;\n    if (r.error_message) line += '  ERROR: ' + String(r.error_message).slice(0, 110);\n    lines.push(line);\n  }\n}\nif (d.still_running) {\n  lines.push('');\n  lines.push('  ' + d.still_running + ' run(s) still in progress; they will appear in a later digest.');\n}\n\nlines.push('');\nlines.push('BRAVE BUDGET');\nlines.push('  ' + b.used + '/' + b.cap + ' used (' + b.percent_used + '%), stop threshold ' +\n           b.threshold + ', ' + b.remaining_to_threshold + ' left before it.');\nif (b.allowed === false) {\n  lines.push('  RUNS ARE BEING REFUSED: ' + b.reason);\n}\n\nreturn [{ json: { subject: 'Lead Finder - weekly report', body: lines.join('\\n') } }];\n"
      }
    },
    {
      "id": "wd-leadsend",
      "name": "Send Lead Report via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        620
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.RESEND_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'leads@' + $env.PRODUCT_DOMAIN, to: $env.KELVIN_EMAIL, subject: $json.subject, text: $json.body }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
