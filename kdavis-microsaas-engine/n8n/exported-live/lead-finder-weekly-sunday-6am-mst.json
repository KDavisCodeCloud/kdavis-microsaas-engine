{
  "name": "Lead Finder \u2014 Weekly Sunday 6am MST",
  "active": true,
  "nodes": [
    {
      "id": "lf-trigger",
      "name": "Sunday 6am MST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * 0"
            }
          ]
        }
      }
    },
    {
      "id": "lf-products",
      "name": "Get Outbound-Enabled Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/marketing/leads/outbound-products",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.MARKETING_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "lf-fanout",
      "name": "One Item Per Product",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per outbound-enabled product. The endpoint returns\n// {products:[...], count:n}; without this the HTTP node downstream would see a\n// single item and trigger exactly one product.\nconst body = $input.first().json || {};\nconst products = Array.isArray(body.products) ? body.products : [];\nif (!products.length) {\n  // Emit a marker rather than nothing, so the digest can say \"none enabled\"\n  // instead of the workflow ending silently with no email at all.\n  return [{ json: { __none: true, count: 0 } }];\n}\nreturn products.map((p) => ({ json: p }));\n"
      }
    },
    {
      "id": "lf-find",
      "name": "Trigger POST /marketing/leads/find",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/marketing/leads/find",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.MARKETING_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ product_id: $json.product_id }) }}",
        "options": {}
      }
    },
    {
      "id": "lf-receipt",
      "name": "Build Queued Receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Sends ONLY on a problem. A good Sunday morning produces no email: the runs\n// were queued, there is nothing to do, and the 20:00 Weekly Digest reports\n// what actually completed. A budget refusal or a failed queue IS actionable,\n// because waiting until 20:00 would cost the week.\nconst items = $input.all();\nconst problems = [];\nlet queued = 0;\n\nfor (const it of items) {\n  const j = it.json || {};\n  if (j.__none) { problems.push('No products have outbound_enabled = true \u2014 nothing was queued.'); continue; }\n  const err = j.error || null;\n  const detail = (err && err.detail) || j.detail || null;\n  if (detail && detail.error === 'brave_budget_exhausted') {\n    const b = detail.budget || {};\n    problems.push('REFUSED on Brave budget: ' + (b.reason || 'budget exhausted'));\n  } else if (j.run_id) {\n    queued++;\n  } else {\n    problems.push('FAILED to queue: ' + String((err && err.message) || JSON.stringify(j)).slice(0, 180));\n  }\n}\n\nif (!problems.length) {\n  // No email. The IF node downstream checks send=false.\n  return [{ json: { send: false, queued: queued } }];\n}\nconst body = ['Lead Finder could not queue this week\\'s runs cleanly.', '']\n  .concat(problems)\n  .concat(['', queued + ' run(s) did queue. The Sunday 20:00 digest reports what completed.']);\nreturn [{ json: { send: true, subject: 'Lead Finder \u2014 attention needed', body: body.join('\\n') } }];\n"
      }
    },
    {
      "id": "lf-gate",
      "name": "Only If A Problem",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1230,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "send",
              "leftValue": "={{ $json.send }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "lf-send",
      "name": "Send Digest via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.RESEND_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'leads@' + $env.PRODUCT_DOMAIN, to: $env.KELVIN_EMAIL, subject: $json.subject, text: $json.body }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Sunday 6am MST": {
      "main": [
        [
          {
            "node": "Get Outbound-Enabled Products",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Outbound-Enabled Products": {
      "main": [
        [
          {
            "node": "One Item Per Product",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One Item Per Product": {
      "main": [
        [
          {
            "node": "Trigger POST /marketing/leads/find",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger POST /marketing/leads/find": {
      "main": [
        [
          {
            "node": "Build Queued Receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Queued Receipt": {
      "main": [
        [
          {
            "node": "Only If A Problem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only If A Problem": {
      "main": [
        [
          {
            "node": "Send Digest via Resend",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}