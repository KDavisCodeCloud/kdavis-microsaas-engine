{
  "name": "DIST Surface Generate \u2014 Daily",
  "active": false,
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Daily 7am MST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "position": [
        200,
        300
      ]
    },
    {
      "id": "run-surface-generate",
      "name": "Trigger DIST-S2/S3 Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/dist/surfaces/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.MARKETING_API_KEY }}"
            }
          ]
        }
      },
      "position": [
        420,
        300
      ]
    }
  ],
  "connections": {
    "Daily 7am MST": {
      "main": [
        [
          {
            "node": "Trigger DIST-S2/S3 Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}