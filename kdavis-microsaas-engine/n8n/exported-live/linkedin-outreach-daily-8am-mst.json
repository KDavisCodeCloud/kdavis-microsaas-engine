{
  "name": "LinkedIn Outreach \u2014 Daily 8am MST",
  "active": true,
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "8am MST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
