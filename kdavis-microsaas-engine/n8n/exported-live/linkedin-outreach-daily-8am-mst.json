      "parameters": {
        "operation": "getAll",
        "tableId": "mse_dm_sequences",
        "filterType": "string",
        "filterString": "status=eq.approved_manual"
      },
      "credentials": {
        "supabaseApi": {
          "id": "pUAkmUAHr9FYYZCw",
          "name": "microsaas-prod Supabase"
        }
      }
    },
    {
      "id": "get-pending-wife-review",
      "name": "Get Pending Wife Review Count",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1080,
        400
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "mse_dm_sequences",
        "filterType": "string",
        "filterString": "status=eq.pending_hitl"
      },
      "credentials": {
        "supabaseApi": {
          "id": "pUAkmUAHr9FYYZCw",
          "name": "microsaas-prod Supabase"
        }
      }
    },
    {
      "id": "build-digest",
      "name": "Build Digest Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Each source is read independently: one empty or failed upstream node must\n// not take down the digest. The previous version used unguarded chains like\n// $(ref).first().json.leads.length and crashed the whole workflow (0 successes\n// in 8 runs). Anything unreadable is named in the body rather than silently\n// reported as zero.\nconst readLeads = (ref) => {\n  try {\n    const items = $(ref).all();\n    if (!items || !items.length) return { n: 0, ok: false };\n    const leads = items[0].json && items[0].json.leads;\n    return Array.isArray(leads) ? { n: leads.length, ok: true } : { n: 0, ok: false };\n  } catch (e) {\n    return { n: 0, ok: false };\n  }\n};\nconst readRows = (ref) => {\n  try {\n    const items = $(ref).all();\n    return { n: items ? items.length : 0, ok: true };\n  } catch (e) {\n    return { n: 0, ok: false };\n  }\n};\n\nconst engager  = readLeads('Get Engager Leads Pending DM');\nconst manual   = readLeads('Get Manual Leads Pending DM');\nconst approved = readRows('Get Approved Ready-To-Paste Count');\nconst pending  = readRows('Get Pending Wife Review Count');\n\nconst lines = [\n  engager.n  + ' engager leads queued for DM',\n  manual.n   + ' manual leads queued for DM',\n  approved.n + ' sequences approved and ready to paste',\n  pending.n  + ' sequences pending wife review',\n];\n\nconst unreadable = [];\nif (!engager.ok)  unreadable.push('engager leads');\nif (!manual.ok)   unreadable.push('manual leads');\nif (!approved.ok) unreadable.push('approved sequences');\nif (!pending.ok)  unreadable.push('sequences pending review');\nif (unreadable.length) {\n  lines.push('');\n  lines.push('NOTE: could not read ' + unreadable.join(', ') + ' -- the counts above may undercount.');\n}\n\nreturn [{ json: { subject: 'LinkedIn Outreach - Daily Digest', body: lines.join('\\n') } }];\n"
      }
    },
    {
      "id": "send-digest",
      "name": "Send Digest via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.RESEND_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'outreach@' + $env.PRODUCT_DOMAIN, to: $env.KELVIN_EMAIL, subject: $json.subject, text: $json.body }) }}"
      }
    }
  ],
