# Exclude local dev artifacts and build output from Railway CLI uploads.
node_modules/
.venv/
venv/
.git/
__pycache__/
*.pyc

# Untracked local file (not in git, not in the GitHub-sourced deploy) that
# causes Railpack's config parser to fail with an encoding error when
# uploaded via `railway up` from this WSL-mounted Windows drive. Excluding
# it here keeps `railway up` usable as a fallback deploy path independent
# of the GitHub webhook trigger.
railpack.json

# Procfile IS git-tracked and clean in the repo (plain ASCII, verified via
# xxd) -- the corruption is specific to how `railway up` reads it off this
# WSL-mounted Windows drive during upload (same class of issue as
# railpack.json above: "yaml: control characters are not allowed" from
# Railpack's parser, 2026-09-22). Safe to exclude from `railway up`
# uploads only: railway.json's deploy.startCommand already duplicates
# Procfile's one line (`python3 -m uvicorn api.main:app --host 0.0.0.0
# --port $PORT`) and takes precedence on Railway regardless, so no deploy
# path loses its start command by skipping Procfile here. The GitHub-
# sourced deploy is untouched -- it reads Procfile from git directly, not
# through this file.
Procfile

# Same WSL-upload corruption, confirmed live 2026-09-22: railway up read
# this git-tracked file's content back as five literal NUL bytes
# ("\0\0\0\0\0") during a real build attempt, which mise's config parser
# correctly rejected ("contains forbidden character '\0'"). Content on
# disk and in git is the plain text "3.11" -- verified with xxd both
# times. This is now the THIRD file (railpack.json, Procfile, this one)
# to hit this exact WSL-mount-upload corruption class; if a future
# railway up attempt hits it on a fourth file, that's the pattern to
# recognize immediately rather than debugging the file itself.
.python-version
